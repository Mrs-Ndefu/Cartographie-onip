<?xml version="1.0" encoding="utf-8"?>
<!-- Le logo occupe toute la zone 108dp ; l'inset de 14dp le ramène dans la "zone sûre" (~72dp)
     pour ne pas être rogné par le masque adaptatif (cercle/carré arrondi selon le launcher). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/onip_logo"
    android:insetLeft="14dp"
    android:insetTop="14dp"
    android:insetRight="14dp"
    android:insetBottom="14dp" />
